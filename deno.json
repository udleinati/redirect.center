{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env src/main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env src/main.ts",
    "reconcile": "deno run --allow-net --allow-read --allow-write --allow-env src/reconcile.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.12.23",
    "hono/cookie": "jsr:@hono/hono@^4.12.23/cookie",
    "hono/compress": "jsr:@hono/hono@^4.12.23/compress",
    "hono/deno": "jsr:@hono/hono@^4.12.23/deno",
    "hono/": "jsr:@hono/hono@^4.12.23/",
    "ventojs": "jsr:@vento/vento@^1.14.0",
    "psl": "npm:psl@^1.15.0",
    "parse-domain": "npm:parse-domain@^5.0.0",
    "s3-lite-client": "jsr:@bradenmacdonald/s3-lite-client@^0.9.6",
    "postgres": "npm:postgres@^3.4.9",
    "@db/redis": "jsr:@db/redis@^0.38.0",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "compilerOptions": {
    "strict": true
  },
  "exclude": ["docker/"]
}
