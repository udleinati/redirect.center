# Production env for docker-compose.prod.yml (Phase 7). Copy to docker/prod.env,
# fill in real values, and keep it out of git:
#
#   cp docker/prod.env.example docker/prod.env
#   docker compose --env-file docker/prod.env -f docker-compose.prod.yml up -d --build

# --- Feature flag ---------------------------------------------------------
# true  = paid HTTPS tier on (Caddy on-demand TLS + S3 + ask).
# false = legacy HTTP-only redirects, byte-for-byte (Caddy serves Caddyfile.off).
HTTPS_TIER_ENABLED=true

# --- Service identity -----------------------------------------------------
FQDN=redirect.center
LOGGER_LEVEL=info

# --- Let's Encrypt (ACME) -------------------------------------------------
ACME_EMAIL=ops@redirect.center
# Start on STAGING; flip to production only after a real domain validates E2E.
CADDY_TLS_ISSUER=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
# Production:
# CADDY_TLS_ISSUER=acme_ca https://acme-v02.api.letsencrypt.org/directory

# --- Cert storage: real, private, encrypted S3 bucket ---------------------
S3_HOST=s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your-cert-bucket
S3_ACCESS_ID=AKIA...
S3_SECRET_KEY=...
S3_PREFIX=certs

# --- On-demand issuance rate limit (optional; defaults shown) --------------
# TLS_ISSUANCE_RATE_LIMIT=20
# TLS_ISSUANCE_RATE_WINDOW_MS=300000

# --- Polar (Merchant of Record) -------------------------------------------
POLAR_WEBHOOK_SECRET=
# The v1 single / whole-domain products are reused as each Scope's cap-1 Tier.
POLAR_PRODUCT_SINGLE_ID=
POLAR_PRODUCT_WHOLE_DOMAIN_ID=
# Larger bundles: "prodId:scope:cap,…". E.g. the single "up to 5" Tier:
#   POLAR_PRODUCT_TIERS=4e109240-4b99-4b50-968f-665d151079c5:single:5
POLAR_PRODUCT_TIERS=
POLAR_CHECKOUT_SINGLE_URL=
POLAR_CHECKOUT_WHOLE_DOMAIN_URL=
POLAR_ACCESS_TOKEN=
POLAR_API_BASE=https://api.polar.sh

# --- Postgres (v2 durable store, ADR-0002) --------------------------------
# Internal-only. Defaults to redirect/redirect; override together if you change
# them. NOTE: pg_dump -> S3 disaster-recovery durability is Phase 12.
# DATABASE_URL=postgres://redirect:redirect@postgres:5432/redirect
# POSTGRES_PASSWORD=redirect
