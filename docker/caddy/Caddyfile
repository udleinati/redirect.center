# Paid HTTPS tier ENABLED.
#
# Caddy fronts ports 80 and 443, terminates TLS, performs on-demand certificate
# issuance gated by the app's /tls-check endpoint, and reverse-proxies every
# request to the internal Deno app with the original Host preserved.
{
	# Certificates persist to S3 (RustFS in dev), so a rebuilt box never re-issues.
	storage s3 {
		host {$S3_HOST}
		bucket {$S3_BUCKET}
		access_id {$S3_ACCESS_ID}
		secret_key {$S3_SECRET_KEY}
		prefix {$S3_PREFIX}
		insecure {$S3_INSECURE}
	}

	# Before obtaining any certificate, ask the app whether the SNI has paid. The
	# app also rate-limits issuance here (Caddy dropped its built-in on_demand
	# rate limit in 2.9), so unknown-hostname / handshake floods can't trigger
	# mass issuance.
	on_demand_tls {
		ask http://app:3000/tls-check
	}

	# Certificate issuer is environment-selected so development never touches
	# Let's Encrypt. Default (dev): Caddy's internal CA. Production sets ACME_EMAIL
	# and points CADDY_TLS_ISSUER at Let's Encrypt — staging until the setup is
	# validated, then production:
	#   ACME_EMAIL=ops@redirect.center
	#   CADDY_TLS_ISSUER=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	#   CADDY_TLS_ISSUER=acme_ca https://acme-v02.api.letsencrypt.org/directory   # once validated
	email {$ACME_EMAIL:dev@localhost}
	{$CADDY_TLS_ISSUER:local_certs}

	# The app emits its own HTTP redirects; don't let Caddy hijack :80 with
	# automatic HTTP->HTTPS redirects.
	auto_https disable_redirects

	# A never-paid SNI is denied a certificate by the ask endpoint, so its TLS
	# handshake fails by design: Caddy cannot present a fallback certificate when
	# on-demand issuance is denied (caddyserver/caddy#5627). Those domains stay on
	# the free HTTP redirect and are won back via the upgrade funnel on the homepage.
	# The 402 page in the :443 block below only covers domains whose cert still
	# exists but whose subscription has lapsed (handshake succeeds there).
}

# HTTPS: on-demand certificates for any paid SNI (gated by the ask endpoint),
# reverse-proxied to the internal Deno app. reverse_proxy preserves the original
# Host header and sets X-Forwarded-For / -Proto / -Host automatically.
:443 {
	tls {
		on_demand
	}
	# A domain whose certificate still exists but whose subscription has lapsed
	# (revoked before cert teardown, or a reconcile gap) completes the handshake,
	# then the app returns 402 (Phase 5 paywall). Intercept it here and serve the
	# static win-back/renew page — no app-rendered HTML. The page reads its own
	# hostname client-side and pre-fills the checkout. Never-paid domains never
	# reach this: their handshake fails first (see the global block note above).
	reverse_proxy app:3000 {
		@unpaid status 402
		handle_response @unpaid {
			route {
				root * /etc/caddy/site
				rewrite * /fallback.html
				templates
				file_server
			}
		}
	}
}

# HTTP: free redirects. With public ACME (prod) Caddy injects the HTTP-01
# challenge handler ahead of this route on port 80.
:80 {
	reverse_proxy app:3000
}
