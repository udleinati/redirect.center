# Paid HTTPS tier ENABLED.
#
# Caddy fronts ports 80 and 443, terminates TLS, performs on-demand certificate
# issuance gated by the app's /tls-check endpoint, and reverse-proxies every
# request to the internal Deno app with the original Host preserved.
{
	# Certificates persist to S3 (MinIO in dev), so a rebuilt box never re-issues.
	storage s3 {
		host {$S3_HOST}
		bucket {$S3_BUCKET}
		access_id {$S3_ACCESS_ID}
		secret_key {$S3_SECRET_KEY}
		prefix {$S3_PREFIX}
		insecure {$S3_INSECURE}
	}

	# Before obtaining any certificate, ask the app whether the SNI has paid.
	on_demand_tls {
		ask http://app:3000/tls-check
	}

	# Dev/local: issue from Caddy's internal CA — never public ACME / Let's
	# Encrypt. Phase 7 removes this and switches to LE staging -> production.
	local_certs

	# The app emits its own HTTP redirects; don't let Caddy hijack :80 with
	# automatic HTTP->HTTPS redirects.
	auto_https disable_redirects

	# Unpaid SNIs can't be issued a cert (the ask endpoint denies them), so the
	# handshake would normally fail. fallback_sni makes Caddy present the internal
	# cert below instead — only AFTER on-demand issuance errors — so the handshake
	# completes (with a name mismatch the browser may warn about) and we can serve
	# the static fallback page. Paid SNIs still issue normally and never hit this.
	fallback_sni fallback.local
}

# Internal cert presented for unpaid SNIs via fallback_sni. Caddy must be managing
# a cert for this name for the fallback to work; `tls internal` issues one at
# startup (and keeps it internal even in prod, where this name has no real cert).
# It is never reverse-proxied — the real Host routes to the :443 block below.
https://fallback.local {
	tls internal
	respond 404
}

# HTTPS: on-demand certificates for any paid SNI (gated by the ask endpoint),
# reverse-proxied to the internal Deno app. reverse_proxy preserves the original
# Host header and sets X-Forwarded-For / -Proto / -Host automatically.
:443 {
	tls {
		on_demand
	}
	# The app returns 402 for an HTTPS request to a domain that hasn't paid
	# (Phase 5 paywall). Intercept it here and serve the static catch-all fallback
	# page from the proxy — no app-rendered HTML. The page reads its own hostname
	# client-side and pre-fills the checkout, so the same bytes serve every domain.
	reverse_proxy app:3000 {
		@unpaid status 402
		handle_response @unpaid {
			route {
				root * /etc/caddy/site
				rewrite * /fallback.html
				templates
				file_server
			}
		}
	}
}

# HTTP: free redirects. With public ACME (prod) Caddy injects the HTTP-01
# challenge handler ahead of this route on port 80.
:80 {
	reverse_proxy app:3000
}
