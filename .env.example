# ───────────────────────────────────────────────────────────────────────────
# redirect.center — environment template for the LOCAL / SANDBOX stack.
#
# Docker Compose auto-loads ".env" from the project root. Copy and edit:
#
#   cp .env.example .env
#   docker compose up --build
#
# This file drives docker-compose.yml (the dev/sandbox stack: Caddy + app +
# RustFS). It uses Caddy's INTERNAL CA — it never talks to Let's Encrypt, so no
# real domain, AWS, or Polar account is needed to try the paid HTTPS tier.
#
# For a production-shaped sandbox (Let's Encrypt staging + real S3) or the real
# cutover, use docker-compose.prod.yml + docker/prod.env.example instead — see
# the README "Paid HTTPS tier (production cutover)".
# ───────────────────────────────────────────────────────────────────────────

# === Feature flag ============================================================
# true  = paid HTTPS tier on (on-demand TLS, RustFS storage, /tls-check, webhooks)
# false = legacy HTTP-only redirects, byte-for-byte (no TLS/datastore code path)
HTTPS_TIER_ENABLED=true

# === Service identity ========================================================
FQDN=redirect.center
LOGGER_LEVEL=info

# === Sandbox seed (v2) =======================================================
# Authorize domains for HTTPS WITHOUT Polar, so you can test issuance directly.
# Plan blocks separated by ";", each "customerId|scope|cap|domain,domain,…"
# (scope = single | whole-domain). Only used when the flag is on. (Real Plans
# arrive via Polar webhooks / `deno task reconcile`.)
SEED_PLANS=demo|single|5|paid-test.redirect.center;demo|whole-domain|1|example-whole.test

# === On-demand issuance rate limit ===========================================
# Defaults shown. Drop the limit to a small number to watch throttling kick in.
TLS_ISSUANCE_RATE_LIMIT=20
TLS_ISSUANCE_RATE_WINDOW_MS=300000

# === S3 cert storage =========================================================
# Defaults point at the bundled RustFS — leave as-is for a local sandbox.
S3_HOST=rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=redirect-center-certs
S3_ACCESS_ID=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_PREFIX=certs
S3_INSECURE=true

# === Polar (Merchant of Record) — OPTIONAL for a local sandbox ===============
# Leave blank to test issuance via SEED_PLANS only. Fill in (Polar TEST mode) to
# exercise checkout, webhooks, and reconcile end-to-end.
POLAR_WEBHOOK_SECRET=
# The v1 single / whole-domain products are reused as each Scope's cap-1 Tier.
POLAR_PRODUCT_SINGLE_ID=
POLAR_PRODUCT_WHOLE_DOMAIN_ID=
# Larger bundles: "prodId:scope:cap,…". E.g. the single "up to 5" Tier:
#   POLAR_PRODUCT_TIERS=4e109240-4b99-4b50-968f-665d151079c5:single:5
POLAR_PRODUCT_TIERS=
POLAR_CHECKOUT_SINGLE_URL=
POLAR_CHECKOUT_WHOLE_DOMAIN_URL=
POLAR_ACCESS_TOKEN=
POLAR_API_BASE=https://api.polar.sh
